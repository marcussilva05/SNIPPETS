		"body": [
			"# String      Exibe literalmente                    print(\"Olá\") → Olá",
			"# Número      Converte para string                  print(42) → 42",
			"# Booleano    Converte para \"True\" ou \"False\"      print(True) → True",
			"# None        Exibe \"None\"                          print(None) → None",
			"# Lista/Tupla Exibe com colchetes/parênteses        print([1,2]) → [1, 2]",
			"# Dicionário  Exibe com chaves                      print({\"a\":1}) → {'a': 1}",
			"# Função      Exibe representação do objeto         print(print) → <built-in function print>",
			"# Módulo      Exibe representação do módulo         print(os) → <module 'os' (frozen)>"
		],
		"description": "cola print()"
	},

